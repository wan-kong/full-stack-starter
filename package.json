{
	"name": "full-stack-starter",
	"version": "0.0.1",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"@better-auth/api-key": "1.6.9",
			"typescript": "^5",
			"@types/bun": "^1.3.4",
			"lucide-react": "1.8.0",
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3",
			"next-themes": "0.4.6",
			"react": "19.2.5",
			"next": "^16.2.0",
			"react-dom": "19.2.5",
			"sonner": "2.0.7",
			"drizzle-kit": "^0.31.10",
			"drizzle-orm": "^0.45.2",
			"mysql2": "^3.22.3",
			"@tailwindcss/postcss": "^4.1.18",
			"elysia": "^1.4.21",
			"tailwindcss": "4.2.2",
			"better-auth": "^1.6.9"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"auth:generate": "turbo run auth:generate --filter=@repo/server",
		"dev:server": "turbo run dev --filter=@repo/server",
		"db:studio": "turbo run db:studio --filter=@repo/db",
		"db:generate": "turbo run db:generate --filter=@repo/db",
		"db:migrate": "turbo run db:migrate --filter=@repo/db",
		"db:push": "turbo run db:push --filter=@repo/db",
		"check": "ultracite check",
		"fix": "ultracite fix",
		"release": "bumpp"
	},
	"dependencies": {
		"@repo/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@biomejs/biome": "2.4.9",
		"@types/bun": "catalog:",
		"bumpp": "^11.0.1",
		"turbo": "^2.8.12",
		"portless": "0.10.3",
		"typescript": "catalog:",
		"ultracite": "7.4.2"
	},
	"packageManager": "bun@1.3.5"
}
